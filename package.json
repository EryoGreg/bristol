{
  "name": "bristol",
  "version": "0.1.0-test.1",
  "description": "Fiches de revision a masques auto-generes, tous sujets",
  "author": "Gregoire Pessiot",
  "main": "src/main/index.js",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "node node_modules/vite/bin/vite.js build",
    "start": "node scripts/dev.js",
    "dist": "node scripts/stage-release.js && node scripts/faire-icone.js && node node_modules/vite/bin/vite.js build && node node_modules/electron-builder/out/cli/cli.js --win portable",
    "polices": "node scripts/polices.js",
    "import": "node scripts/lancer-node.js src/main/import.js",
    "postinstall": "node scripts/binaire-sqlite.js"
  },
  "dependencies": {
    "adm-zip": "^0.5.18",
    "better-sqlite3": "^11.7.0",
    "google-auth-library": "^9.15.0",
    "jimp": "^0.22.12"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "fr.bristol.app",
    "productName": "Bristol",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "src/main/**",
      "dist/**",
      "package.json",
      "node_modules/**"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "data/pack.db",
        "to": "data/pack.db"
      },
      {
        "from": "data/images",
        "to": "data/images"
      },
      {
        "from": "data/ATTRIBUTIONS.md",
        "to": "ATTRIBUTIONS.md"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Bristol-${version}.${ext}"
    },
    "portable": {
      "unpackDirName": "Bristol-${version}",
      "requestExecutionLevel": "user"
    }
  }
}
